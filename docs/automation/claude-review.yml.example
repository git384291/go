# 비활성 초안. .github/workflows 아래에 있지 않으므로 실행되지 않는다.
# 활성화 조건과 인증 절차는 같은 폴더 README.md 참고.
name: Claude PHASE 1 review

on:
  issue_comment:
    types: [created]

permissions: {}

concurrency:
  group: claude-review-${{ github.event.issue.number }}
  cancel-in-progress: false

jobs:
  review:
    if: >-
      vars.FIDEON_CLAUDE_REVIEW_ENABLED == 'true' &&
      github.repository == 'git384291/go' &&
      github.event.issue.pull_request &&
      github.event.issue.number == 1 &&
      github.event.comment.user.login == github.repository_owner &&
      contains(github.event.comment.body, '@claude')
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    permissions:
      contents: read
      pull-requests: write
      issues: write
      actions: read
    steps:
      - name: Confirm the approved Draft PR scope
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh pr view 1 --repo git384291/go \
            --json state,isDraft,headRefName,isCrossRepository \
            --jq 'select(.state == "OPEN" and .isDraft == true and .headRefName == "phase1-product-scope" and .isCrossRepository == false) | .headRefName' \
            | grep -Fx 'phase1-product-scope'
      - uses: actions/checkout@v6
        with:
          ref: phase1-product-scope
          persist-credentials: false
      - name: Review only
        uses: anthropics/claude-code-action@v1
        with:
          github_token: ${{ github.token }}
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          prompt: |
            FIDEON Draft PR #1에 대한 읽기 전용 검토입니다.
            docs/PHASE1-STATUS.md와 docs/OPEN-ISSUES.md를 먼저 읽으세요.
            OI-002 관리자 로그인 → TOTP → openStaffSession 연결의 누락과
            Supabase 개발 환경에서 필요한 검증을 코드 경로와 함께 한국어로 설명하세요.
            코드 변경, 커밋, push, main 병합, 운영 배포, PHASE 2 활성화,
            실제 고객정보 수집은 하지 마세요. 비밀값을 읽거나 출력하지 마세요.
            검토 결과는 이 PR의 댓글로만 남기세요.
          claude_args: |
            --max-turns 10
            --disallowedTools "Bash,Edit,Write,NotebookEdit"
