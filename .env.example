# 예시 파일. 실제 값은 커밋하지 않는다. 운영 값은 Vercel 환경변수에만 둔다.
# --- 고객정보 수집 스위치 (REV-004: 'local' 외 값은 모두 차단) ---
LEAD_INTAKE_MODE=disabled
NEXT_PUBLIC_LEAD_FORM_ENABLED=false
PRIVACY_POLICY_VERSION=
NEXT_PUBLIC_PRIVACY_POLICY_VERSION=
# --- DB (서버 전용, 연결 풀러 트랜잭션 모드) ---
DATABASE_URL=postgres://app_server@127.0.0.1:54329/fideon_test
SUPABASE_DB_CA_CERT=
# --- 서버 서명 키: <key_id>:<base64 32바이트 이상>. DB security.server_keys와 같은 값 ---
FIDEON_STAFF_SIGNING_KEY=
FIDEON_LEAD_SIGNING_KEY=
# --- 개인정보 암호화 ---
PII_ENC_KEYS={"1":"<base64 32바이트>"}
PII_ENC_CURRENT=1
PII_HMAC_KEY=
PII_IP_HASH_KEY=
# --- 관리자 인증 (기본 꺼짐. 'supabase' + 아래 값·DB·서명 키가 모두 있어야 켜짐. 운영에서는 켜지지 않음) ---
ADMIN_AUTH_MODE=disabled
# 관리자 리드 출처(기본 mock). db는 개발·시험의 지정된 로컬 폐기 DB에서만 열리고 그 밖에는 503. 운영 실데이터 읽기 아님
ADMIN_LEADS_SOURCE=mock
# --- 인증·봇 차단 ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
TURNSTILE_SECRET_KEY=
# 공개 사이트 키(비밀 아님). 비어 있으면 상담 폼이 Turnstile 스크립트·iframe을 만들지 않고 전송하지 않는다
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_HOSTNAME=
NEXT_PUBLIC_KAKAO_CHANNEL_URL=
# --- 출시 준비(기본 비어 있음 = 닫힘). 값은 Vercel 환경 변수에만 둔다. 점검: npm run preflight:launch ---
# 공식 도메인 확정 후 https 원본만(예: https://<확정 도메인>). 비어 있으면 canonical·sitemap 없음
PUBLIC_SITE_ORIGIN=
# 'allow'여도 운영 + 공식 주소 + layout noindex 해제(PM 승인 변경안) 전에는 검색 노출 안 됨
SEARCH_INDEXING=
# 광고·상담 목적지(확보된 총판 공식 접수 경로). https 공개 도메인, 쿼리 없음. 비어 있으면 광고 대기
LAUNCH_INTAKE_DESTINATION=

# --- 상담·견적·시험 스위치 (P1 보완 11/22). 실제 값(비밀)은 커밋하지 않는다. 필수/선택/기본값은 docs/DEPLOY-CHECKLIST.md P절 ---
# AI 상담 화면·API 스위치: 정확히 'true'일 때만 열림(기본 꺼짐)
CONSULT_CHAT_ENABLED=false
# 상담 화면이 고정하는 상품·통신사·지역 코드(소문자·숫자·_-). 하나라도 비면 입력창이 열리지 않음
CONSULT_CHAT_CARRIER=
CONSULT_CHAT_PRODUCT=
CONSULT_CHAT_REGION=
# 상담 세션 서명 키(base64 32바이트). 비어 있으면 상담 세션을 발급하지 않음
CONSULT_SESSION_KEY=
# AI 모델: 'mock'(시험·로컬 전용) 또는 공식 단가 확인 기록에 있는 모델 ID(예: gpt-5.6-luna). 그 밖·비움 = 모델 없음
CONSULT_AI_MODEL=
# 실제 AI(PM 11/24 ④): 위 모델 ID가 공식 단가 확인 기록에 있고, 아래 3개가 모두 있을 때만 전송. 'mock'은 시험·로컬 전용(운영 배포에서는 무시)
# 키는 서버 전용 비밀(클라이언트·로그·응답 노출 금지, 저장소에 값 넣지 말 것). 주소는 https://api.openai.com/v1/responses 만 허용
CONSULT_AI_API_KEY=
CONSULT_AI_ENDPOINT=
# 정확히 'allow'일 때만 실제 전송(비용 한도는 DB core.ai_budget_config)
CONSULT_AI_EXECUTION=
CONSULT_AI_MONTHLY_BUDGET_KRW=0
# 견적 API 스위치('true'일 때만) · 견적·총판 신청서에 쓰는 공급처 ID(소문자·숫자·_-)
CONSULT_QUOTE_ENABLED=false
QUOTE_SUPPLIER_ID=
# 상담 미리보기 화면('true'일 때만, 기본 404)
CONSULT_PREVIEW_ENABLED=false
# 관리자 데이터 출처: 기본 닫힘. 'db'는 개발·시험의 로컬 폐기 DB에서만 열림(운영 실데이터 읽기 아님)
ADMIN_AD_SOURCE=
ADMIN_POLICY_SOURCE=
# 광고 매체: 'mock'(모의) 또는 'google_ads'(아래 인증 4종 + AD_LANDING_URL이 모두 있어야 선택됨, 하나라도 없으면 닫힘). 실계정 연결은 대표 승인 뒤
AD_PLATFORM=
# 광고 최종 URL(https, 쿼리 없음). 클릭 추적 꼬리표 utm_source=google·utm_medium=cpc·utm_campaign=<캠페인 키>는 서버가 붙인다
AD_LANDING_URL=
# 실제 광고 집행 스위치: 기본 꺼짐. 정확히 true일 때만 live 어댑터가 집행 가능(google_ads는 live. 캠페인·광고 그룹·광고는 모두 PAUSED로만 만든다. 승인 전 true 금지)
AD_EXECUTION_ENABLED=false
# 광고 정기 감시(/api/internal/ad-monitor) 인증 비밀: 32자 이상. 비우면 감시 꺼짐(503) → 정상 감시 기록이 없어 새 집행도 DB가 차단(MONITOR_STALE). 비밀은 Vercel에만
AD_MONITOR_SECRET=
# Vercel Cron을 쓸 때는 CRON_SECRET(32자 이상)을 두면 Vercel이 'Authorization: Bearer <값>'으로 자동 전송한다(AD_MONITOR_SECRET이 없을 때 사용). 등록은 배포 승인 사항
CRON_SECRET=
# Google Ads 어댑터 credential 이름(값은 넣지 않는다 — AD_PLATFORM=google_ads일 때만 서버가 읽음, 실계정 연결은 승인 뒤). 비밀은 Vercel에만
# 필수(OAuth + Google Cloud 프로젝트 기반 접근, developer token 불필요):
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# 선택:
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=   (관리자 계정 경유 시만)
# GOOGLE_ADS_API_VERSION=         (major만, 기본 v26. v26.2 같은 minor 지정 불가)
# GOOGLE_ADS_DEVELOPER_TOKEN=     (legacy·선택: 있어도 서버가 무시, 신규 연동은 비워 둔다)
# --- 시험 전용(운영·미리보기 빌드는 코드가 무시). 운영 환경에 설정하지 않는다 ---
# TURNSTILE_VERIFY_URL_TEST=http://127.0.0.1:<포트>/turnstile
# DIAG_IP_ENABLED=
# --- 플랫폼이 넣는 값(직접 설정하지 않는다): NODE_ENV, VERCEL, VERCEL_ENV ---
